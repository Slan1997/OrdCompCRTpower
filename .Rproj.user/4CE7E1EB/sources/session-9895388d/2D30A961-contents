### get the posterior mean for all covariates.
mean_risk_per_group = NULL

for (j in 1:nCovariates){
  probMat = dt_cov %>% dplyr::select(j,33) 
  colnames(probMat) = c("x","class")
  if (nCategories[j]==1){
    ## decide to adjust the category for the index case variable
    probMat = probMat %>% mutate(x=1-x)
    nCategories[j]=2
  }
  if (nCategories[j]==2){
     temp_cov = probMat %>% group_by(class) %>%
      summarise(prop = mean(x)) %>% pull(prop)
    temp_mean = mean(probMat$x)
    out = c(temp_cov, temp_mean)
  }else{
    probMat_wide = model.matrix(~ x - 1, 
                                data = probMat %>% mutate(x=as.factor(x))) 
    out = apply(probMat_wide,2,
          function(x){
            tempmat = tibble(x,probMat$class)
            names(tempmat) = c("x","class")
            temp_cov =tempmat %>% group_by(class) %>%
              summarise(prop=mean(x)) %>% pull(prop)
            temp_mean = mean(tempmat$x)
            c(temp_cov,temp_mean)
            #print(c(temp_cov,temp_mean))
            })
  }
  mean_risk_per_group = cbind(mean_risk_per_group,out)
