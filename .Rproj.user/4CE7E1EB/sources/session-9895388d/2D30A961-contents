### Odds Ratio and Credible Interval

```{r, message=FALSE,warning=FALSE}
# Turning Risk Matrix into Data Frame
## V1 - Vnclus: reference group, lowest risk group - highest risk group
### need to reorder the columns by their posterior risk to get the corresponding results in the risk plot 
# This order has been saved as the output of clusterOrderObj1
# This order is also just "risk_order"

#### use 1st group as the reference group
sp_Risk <- as.data.frame(riskProfileObj2$risk[,risk_order,])
names(sp_Risk) = paste0("V",1:ncol(sp_Risk))

nclus = ncol(sp_Risk)
reference_grp = sp_Risk$V1/(1-sp_Risk$V1) # 1*20,000
## Using Mean Prob
reference_grp1 = mean(sp_Risk$V1)/(1-mean(sp_Risk$V1))
OR_output = data.frame(Cluster = 2:nclus,
                       OR=rep(NA,(nclus-1)),
                       OR_mean=rep(NA,(nclus-1)),
                       Lower_CI = rep(NA,(nclus-1)),
                       Upper_CI = rep(NA,(nclus-1)))

for (i in 1:(nclus-1)){
  subrisk = sp_Risk[,(i+1)]
  ORs = subrisk/(1-subrisk) / reference_grp
  ### Posterior Mean OR + 95% Credible Interval
  OR_output[i,'OR'] = mean(ORs)
  ## Using Mean Prob
  OR_output[i,'OR_mean'] = mean(subrisk)/(1-mean(subrisk)) / reference_grp1
  OR_output[i,c('Lower_CI','Upper_CI')] = 
    as.numeric(quantile(ORs, probs = c(0.025,0.975)))
}
OR_output$significant = ifelse(OR_output$Lower_CI<=1 & 
                              OR_output$Upper_CI>=1,  F, T)
