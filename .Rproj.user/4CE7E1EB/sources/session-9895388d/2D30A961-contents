n_sweeps = 2e4
n_burn = 2e4
start = Sys.time() 
fit <- profRegr(data = clean_covid_num1, outcome = "any_symptom_fu90", 
                        covNames =covNames, nClusInit = 20, output = "sp_output",
                        nSweeps = n_sweeps, nBurn = n_burn, predict = preds, 
                seed = 79 
