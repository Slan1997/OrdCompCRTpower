####### function to get prop_ct
get_prop_ct = function(corr_assump,
                       vine_type, # "C" or "D"
                       family,# e.g., "Gaussian", "Joe"
                       components_order=1:5 # 1-5 severity score for component 1-5
){
  A0 = corr_assump
  idx = components_order
  
  if (family=="Gaussian"){
    family_idx = 1
  }else if (family=="Clayton"){
    family_idx = 3
  }else if (family=="Gumbel"){
    family_idx = 4
  }else if (family=="Frank"){
    family_idx = 5
  }else if (family=="Joe"){
    family_idx = 6
  }
  
  if (vine_type=="D"){
    tree1_tau = c(A0[idx[1],idx[2]],A0[idx[2],idx[3]],A0[idx[3],idx[4]],A0[idx[4],idx[5]])
    tree2_tau = c(A0[idx[1],idx[3]],A0[idx[2],idx[4]],A0[idx[3],idx[5]])
    tree3_tau = c(A0[idx[1],idx[4]],A0[idx[2],idx[5]])
    tree4_tau = c(A0[idx[1],idx[5]])
  }else{ #vine_type=="C"
    tree1_tau = A0[idx[1],idx[2:5]]
    tree2_tau = A0[idx[2],idx[3:5]]
    tree3_tau = A0[idx[3],idx[4:5]]
    tree4_tau = A0[idx[4],idx[5]]
  }
  family_tree1 = rep(family_idx,4)
  family_tree2 = rep(family_idx,3)
  family_tree3 = rep(family_idx,2)
  family_tree4 = rep(family_idx,1)
  
  if (any(A0==0,na.rm=T)){
    family_tree1[tree1_tau==0] = 0
    family_tree2[tree2_tau==0] = 0
    family_tree3[tree3_tau==0] = 0
    family_tree4[tree4_tau==0] = 0
  }
  param_list = list(BiCopTau2Par(family=family_tree1,tau=tree1_tau),
                    BiCopTau2Par(family=family_tree2,tau=tree2_tau),
                    BiCopTau2Par(family=family_tree3,tau=tree3_tau),
                    BiCopTau2Par(family=family_tree4,tau=tree4_tau))
  method_list_update = list(family_tree1,family_tree2,family_tree3,family_tree4)
  method_list_update1 = lapply(method_list_update,
                               function(x){
                                 y=as.character(x)
                                 y[x==0] = "Indep"
                                 y[x!=0] = family
                                 y})
  
  SetupInfo = VCO_Initialize(nComp = 5,
                             prev = as.numeric(p_tn[idx]),
                             vine_type = vine_type,
                             method_list=method_list_update1,#c('Gaussian',rep("Indep",3)),
                             rho_list = NULL,
                             param_list = param_list)
  ### get multivariate binary joint distribution
  output = gen_jointpmf(SetupInfo)
  list_joint_pmf = output$list_joint_pmf
  jointpmf = output$jointpmf
  
  VCO_appr_prop = Ordinal_PMF(jointpmf,
                              method='order',
                              severity_score_increasing=order(idx))
  VCO_appr_prop
}
