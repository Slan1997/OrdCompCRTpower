### function to get sample size
# expected treatment effect size: log(1.5)
# n_c = A*n_E, n_E = 1/(A+1) * n
get_ave_prop = function(pr_ct0,theta_R0,A_Rate,print=T){
  pr_trt = 1 / (1 + (1/pr_ct0 - 1)*exp(-theta_R0)  )
  pr = (pr_trt+A_Rate*pr_ct0)/(A_Rate+1)
  if (print) cat(
    "Prob_ct: ", paste0(round(pr_ct0, digits = 3), collapse = ", "), "\n",
    "Prob_trt: ", paste0(round(pr_trt, digits = 3), collapse = ", "), "\n",
    "Prob: ", paste0(round(pr, digits = 3), collapse = ", "), "\n"
  )
  list(pr=pr,
       pr_trt=pr_trt,
       pr_ct=pr_ct0)
}

get_cat_probs_from_control <- function(p_C, theta, A_Rate = 1, print = TRUE) {
  # p_C: category-specific probabilities in the control arm
  #      ordered from best to worst, or consistently with your PO model
  # theta: log odds ratio on the cumulative odds scale
  # A_Rate: allocation ratio A = n_C / n_T
  #         A_Rate = 1 for equal allocation
  
  # Basic checks
  if (any(p_C < 0)) {
    stop("All elements of p_C must be nonnegative.")
  }
  if (abs(sum(p_C) - 1) > 1e-6) {
    stop("p_C must sum to 1.")
  }
  if (length(p_C) < 2) {
    stop("p_C must contain at least two categories.")
  }
  
  L <- length(p_C)
  
  # Control-arm cumulative probabilities up to category L-1
  # gamma_C^ell = P(W <= ell | X = 0), ell = 1,...,L-1 in R indexing
  gamma_C <- cumsum(p_C)[1:(L - 1)]
  
  # Treatment-arm cumulative probabilities under proportional odds model
  gamma_T <- 1 / (1 + (1 / gamma_C - 1) * exp(-theta))
  
  # Convert treatment cumulative probabilities back to category probabilities
  p_T <- c(
    gamma_T[1],
    diff(gamma_T),
    1 - gamma_T[L - 1]
  )
  
  # Allocation-weighted average category-specific probabilities
  # A_Rate = n_C / n_T
  p_avg <- (p_T + A_Rate * p_C) / (A_Rate + 1)
  
  if (print) {
    cat(
      "p_C:   ", paste0(round(p_C, 4), collapse = ", "), "\n",
      "p_T:   ", paste0(round(p_T, 4), collapse = ", "), "\n",
      "p_avg: ", paste0(round(p_avg, 4), collapse = ", "), "\n"
    )
  }
  
  list(
    p_C = p_C,
    p_T = p_T,
    p_avg = p_avg,
    gamma_C = gamma_C,
    gamma_T = gamma_T
  )
}

ss = function(A=1,theta_R_expected = log(1.5),target_power,pr_ct=NULL,pr=NULL){
  if (is.null(pr)){
    ## get pr_trt and overall pr 
    pr = get_cat_probs_from_control(p_C=pr_ct, theta=theta_R_expected, A_Rate = A, print = TRUE)$p_avg
    #pr = get_ave_prop(pr_ct0=pr_ct,theta_R0=theta_R_expected,A_Rate=A)[[1]]
  }
  sum_cube = sum(pr^3)
  n = 3*(A+1)^2 * (qnorm(.975)+qnorm(target_power) )^2 / (theta_R_expected^2*A*(1-sum_cube) )
  ceiling(n)
}

get_all_info = function(A=1,theta_R_expected = log(1.5),target_power,
                        true_prop_ave,
                        pr_ct=NULL,pr=NULL){
  if (is.null(pr)){
    ## get pr_trt and overall pr 
    pr = get_cat_probs_from_control(p_C=pr_ct, theta=theta_R_expected, A_Rate = A, print = TRUE)$p_avg
    
  }
  sum_cube = sum(pr^3)
  n = 3*(A+1)^2 * (qnorm(.975)+qnorm(target_power) )^2 / (theta_R_expected^2*A*(1-sum_cube) )
  est_ss = ceiling(n)
  
  # the corresponding power of the est_ss
  est_power = wh_power(theta_R=theta_R_expected,n=est_ss, pr=true_prop_ave,A=A)
  
  return(list(target_power = target_power,
              overall_pr = pr,
              true_prop_ave = true_prop_ave,
              est_ss=est_ss,
              est_power=est_power))
}

