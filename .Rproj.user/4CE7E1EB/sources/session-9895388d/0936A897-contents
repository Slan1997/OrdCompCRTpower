estimate_rho_matrix <- function(data, pi_df,useP=T,
                                weights = NULL) {
  
  stopifnot(all(c("cluster","treat","Y") %in% names(data)))
  stopifnot("treat" %in% names(pi_df))
  
  # ---- Setup ----
  n_thresh <- ncol(pi_df) - 1  # exclude treat column
  if (n_thresh < 1) stop("pi_df must contain at least one pi_k column (pi_1).")
  
  # Make sure Y is an ordered factor whose labels are 0,1,2,... (as in your collapse_factor output)
  # If Y is numeric, coerce carefully.
  if (!is.factor(data$Y)) {
    data <- data %>% dplyr::mutate(Y = factor(Y, ordered = TRUE))
  }
  
  # Join pi's (control only)
  data_pi <- data %>%
    dplyr::select(cluster, treat, Y) %>%
    dplyr::left_join(pi_df, by = "treat")
  
  # ---- Build standardized residual matrix E (N x n_thresh) ----
  # Binary case: n_thresh = 1, only need one indicator: I(Y==0)
  if (n_thresh == 1) {
    
    # Ensure baseline category corresponds to Y=0
    # With your collapse_factor(), levels are 0,1,... so level 1 is "0"
    bin1 <- as.integer(data_pi$Y == levels(data_pi$Y)[1])
    
    p1 <- data_pi[["pi_1"]]
    e1 <- (bin1 - p1) / sqrt(p1 * (1 - p1))
    
    e_mat <- data_pi %>%
      dplyr::mutate(e1 = e1)
    
    e_cols <- "e1"
    
  } else {
    
    # Ordinal case: one-hot encode all levels; use first n_thresh indicator columns (Y==0,...,Y==n_thresh-1)
    mm <- model.matrix(~ Y - 1, data = data_pi)
    colnames(mm) <- paste0("bin_Y", seq_len(ncol(mm)))
    
    e_mat <- dplyr::bind_cols(data_pi, as.data.frame(mm))
    
    for (k in 1:n_thresh) {
      pi_name  <- paste0("pi_", k)
      bin_name <- paste0("bin_Y", k)
      e_name   <- paste0("e", k)
      
      e_mat[[e_name]] <- (e_mat[[bin_name]] - e_mat[[pi_name]]) /
        sqrt(e_mat[[pi_name]] * (1 - e_mat[[pi_name]]))
    }
    
    e_cols <- paste0("e", 1:n_thresh)
  }
  
  # ---- Cluster-specific rho ----
  rho_list <- e_mat %>%
    dplyr::group_by(cluster) %>%
    dplyr::summarise(
      Ti = dplyr::n(),
      rho = list({
        E  <- as.matrix(dplyr::pick(dplyr::all_of(e_cols)))
        Ti <- nrow(E)
        
        if (Ti <= 1) return(matrix(NA_real_, n_thresh, n_thresh))
        
        s  <- colSums(E)
        S1 <- tcrossprod(s, s)
        S2 <- crossprod(E, E)
        # num <- S1 - S2
        # denom <- Ti * (Ti - 1) - useP*ncol(pi_df)
        
        num <- (S1 - S2) / 2
        denom <- Ti * (Ti - 1) / 2 - useP*ncol(pi_df)
        rho_hat <- num / denom
        
        (rho_hat + t(rho_hat)) / 2
      }),
      .groups = "drop"
    )
  
  # ---- Stack into array ----
  rho_array <- simplify2array(rho_list$rho)
  
  # ---- Weights: pair counts ----
  Ti_vec  <- rho_list$Ti
  if (is.null(weights)) {
    # weights <- Ti_vec * (Ti_vec - 1)
    weights <- Ti_vec * (Ti_vec - 1) /2
  } else if (is.character(weights) && length(weights) == 1) {
    if (weights == "pairs") {
      weights <- Ti_vec * (Ti_vec - 1)
    } else if (weights == "cluster_size") {
      weights <- Ti_vec
    } else {
      stop("weights must be NULL, 'pairs', 'cluster_size', a scalar, or a numeric vector.")
    }
  } else if (length(weights) == 1 && is.numeric(weights)) {
    weights <- rep(weights, length(Ti_vec))
  } else if (is.numeric(weights) && length(weights) == length(Ti_vec)) {
    weights <- weights
  } else {
    stop("Invalid weights input.")
  }
  
  # ---- Weighted average ----
  if (n_thresh == 1) {
    
    rho_vec <- as.numeric(rho_array)
    rho_est <- matrix(
      weighted.mean(rho_vec, w = weights, na.rm = TRUE),
      nrow = 1, ncol = 1
    )
    
  } else {
    
    rho_est <- apply(
      rho_array,
      c(1, 2),
      function(x) weighted.mean(x, w = weights, na.rm = TRUE)
    )
  }
  
  dimnames(rho_est) <- list(
    paste0("Y=", 0:(n_thresh - 1)),
    paste0("Y=", 0:(n_thresh - 1))
  )
  
  rho_est
}
