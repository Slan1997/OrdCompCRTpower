grid_results <- crossing(
  scenarios_out2 %>% 
    select(scenario_id, n_cat, pi_vec, pi_thr, rho_est_weighted, rank_icc),
  theta = treat_lor,
  method = c("GEE", "WH-DE-Rank")
) %>%
  mutate(
    N_out = pmap(
      list(method, n_cat, pi_vec, pi_thr, rho_est_weighted, rank_icc, theta),
      function(method, n_cat, pi_vec, pi_thr, rho_mat, rank_icc, theta) {
        
        if (method == "GEE") {
          
          if (n_cat == 2) {
            solve_clusters_binary(
              P0 = as.numeric(pi_vec[2]),   # event prob in control
              theta_R = theta,
              rho = as.numeric(rho_mat[1, 1]),
              cluster_size = cluster_size
            )
          } else {
            solve_number_cluster(
              pi_C_hat = as.numeric(pi_thr),
              theta = theta,
              cluster_size = cluster_size,
              rho_matrix = rho_mat
            )
          }
          
        } else if (method == "WH-DE-Rank") {
          
          if (n_cat == 2) {
            solve_clusters_binary(
              P0 = as.numeric(pi_vec[2]),   # event prob in control
              theta_R = theta,
              rho = as.numeric(rank_icc),
              cluster_size = cluster_size
            )
          } else {
            solve_number_clusters_eq10(
              log_OR = theta,
              prop_categories = as.numeric(pi_vec),  # collapsed proportions
              ICC = as.numeric(rank_icc),
              cluster_size = cluster_size,
              target_power = 0.80,
              alpha = 0.05
            )
          }
          
        } else {
          stop("Unknown method")
        }
      }
    ),
    
    OR = exp(theta),
    N_continuous   = map_dbl(N_out, ~ .x$N_required_continuous),
    N_integer      = map_int(N_out, ~ .x$N_required_integer),
    achieved_power = map_dbl(N_out, ~ .x$achieved_power),
    
    pi_C_hat = map2(N_out, pi_vec, ~ if ("pi_C_hat" %in% names(.x)) .x$pi_C_hat else .y),
    pi_T_hat = map(N_out, ~ if ("pi_T_hat" %in% names(.x)) .x$pi_T_hat else NA)
  ) %>%
  select(
    scenario_id, method, n_cat, theta, OR, rank_icc,
    N_continuous, N_integer, achieved_power, pi_C_hat, pi_T_hat
  )


