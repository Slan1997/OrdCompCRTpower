bin1 <- as.integer(data_pi$Y == levels(data_pi$Y)[1])
p1 <- data_pi[["pi_1"]]
e1 <- (bin1 - p1) / sqrt(p1 * (1 - p1))

e_mat <- data_pi %>%
  dplyr::mutate(e1 = e1)

e_cols <- "e1"

useP=T

# ---- Cluster-specific rho ----
rho_list <- e_mat %>%
  dplyr::group_by(cluster) %>%
  dplyr::summarise(
    Ti = dplyr::n(),
    rho = list({
      E  <- as.matrix(dplyr::pick(dplyr::all_of(e_cols)))
      Ti <- nrow(E)
      
      if (Ti <= 1) return(matrix(NA_real_, n_thresh, n_thresh))
      
      s  <- colSums(E)
      S1 <- tcrossprod(s, s)
      S2 <- crossprod(E, E)
      num <- S1 - S2
      
      denom <- Ti * (Ti - 1) - useP*ncol(pi_df)
      rho_hat <- num / denom
      
      (rho_hat + t(rho_hat)) / 2
    }),
    .groups = "drop"
  )

