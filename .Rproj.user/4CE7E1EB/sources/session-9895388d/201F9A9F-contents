make_cluster_plot_truth <- function(df,
                                    drop_scenarios = NULL,
                                    truth_scenario = "Ordinal-3cat1",
                                    keep_data_only_for_truth = TRUE) {
  
  d <- df
  
  # 1) remove Ordinal-6cat
  d <- d %>%
    filter(scenario_id != "Ordinal-6cat")
  
  # 2) optionally remove data-driven for all scenarios except truth
  if (isTRUE(keep_data_only_for_truth)) {
    d <- d %>%
      filter(!(rho_source == "Data-driven" & scenario_id != truth_scenario))
  }
  
  # 3) extract truth values (data-driven only)
  truth_df <- d %>%
    filter(scenario_id == truth_scenario, rho_source == "Data-driven") %>%
    distinct(OR, N)
  
  # 4) remove truth scenario from point layer
  d <- d %>%
    filter(scenario_id != truth_scenario)
  
  # 5) optional drop scenarios
  if (!is.null(drop_scenarios)) {
    d <- d %>%
      filter(!as.character(scenario_id) %in% drop_scenarios) %>%
      droplevels()
  }
  
  ggplot(
    d,
    aes(
      x = scenario_id,
      y = N,
      color = rho_label,
      group = rho_label
    )
  ) +
    geom_hline(
      data = truth_df,
      aes(yintercept = N, linetype = "Data-driven"),
      inherit.aes = FALSE,
      color = "black",
      linewidth = 0.7
    ) +
    geom_point(size = 1.5, alpha = 0.85) +
    facet_wrap(~ OR, nrow = 1, labeller = label_both) +
    scale_color_manual(values = okabe_ito2, name = expression(rho)) +
    scale_linetype_manual(
      name = expression(rho~source),
      values = c("Data-driven" = "dashed")
    ) +
    scale_y_continuous(
      limits = c(0, NA),
      breaks = function(x) seq(
        0,
        ceiling(max(x, na.rm = TRUE) / 5) * 5,
        by = 5
      ),
      expand = expansion(mult = c(0, 0.03))
    ) +
    labs(
      x = "Outcome definition",
      y = "Required number of clusters (continuous)"
    ) +
    theme_bw(base_size = 12) +
    theme(
      axis.text.x = element_text(angle = 45, hjust = 1),
      panel.grid.minor = element_blank(),
      legend.position = "right",
      legend.box = "vertical"
    )
}
