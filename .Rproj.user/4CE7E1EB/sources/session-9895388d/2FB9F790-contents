  })
  
  or_grid_reactive <- reactive({
    parse_or_grid(
      mode = input$or_grid_mode,
      or_min = input$or_grid_min,
      or_max = input$or_grid_max,
      or_step = input$or_grid_step,
      or_custom = input$or_grid_custom
    )
  })
  
  clusters_assumed_df <- reactive({
    x <- resolved_inputs()
    
    shiny::validate(
      need(input$J >= 2, "Cluster size must be ≥ 2.")
    )
    
    df <- compute_clusters_assumed_df(
      p_C_vec = x$p_C_vec,
      or_grid = or_grid_reactive(),
      cluster_size = input$J,
      alpha = input$alpha,
      target_power = input$target_power / 100,
      rho_entry_grid = rho_entry_grid_reactive(),
      add_bin = input$add_bin,
      round_even = FALSE
    )
    
    shiny::validate(
      need(nrow(df) > 0, "Unable to compute required number of clusters for the selected OR and rho grids.")
    )
    
    df
  })
  
  # -----------------------------
  # Compute power across N
  # -----------------------------
  power_df <- reactive({
    shiny::validate(
      need(exists("calculate_power_3cat"), "calculate_power_3cat() not found. Did you source your R/ files?"),
      need(is.function(calculate_power_3cat), "calculate_power_3cat exists but is not a function."),
      need(current_rho_valid(), "Current rho11, rho12, rho22 combination does not yield positive V_\u03b8.")
    )
    
    Ns <- N_seq()
    combo <- input$input_combo
    
    to_pct <- function(x) {
      if (is.null(x) || length(x) == 0 || is.na(x)) return(NA_real_)
      round(100 * as.numeric(x), 2)
    }
    
    res_list <- lapply(Ns, function(N) {
      args <- switch(
        combo,
        "pc_or" = list(p_C_vec = pC_vec(), treatment_effect = theta_val()),
        "pc_pt" = list(p_C_vec = pC_vec(), p_T_vec = pT_vec()),
        "pc_pi" = list(p_C_vec = pC_vec(), pi_vec = pi_vec_reactive()),
        "pt_or" = list(p_T_vec = pT_vec(), treatment_effect = theta_val()),
        "pt_pi" = list(p_T_vec = pT_vec(), pi_vec = pi_vec_reactive()),
        "pi_or" = list(pi_vec = pi_vec_reactive(), treatment_effect = theta_val())
      )
      
      out <- do.call(
        calculate_power_3cat,
        c(
          list(
            number_cluster = N,
            cluster_size   = input$J,
            rho11          = input$rho11,
            rho12          = input$rho12,
            rho22          = input$rho22,
            add_bin        = input$add_bin,
            bin_rho1       = NULL,
            bin_rho2       = NULL,
            add_indep      = input$add_indep,
            alpha          = input$alpha
          ),
          args
        )
      )
      
      data.frame(
        N           = as.integer(N),
        GEE_Ordinal = to_pct(out$power_GEE_exch),
        GEE_Binary1 = to_pct(out$power_GEE_bin1),
        GEE_Binary2 = to_pct(out$power_GEE_bin2),
        GEE_Indep   = to_pct(out$power_GEE_indep),
        Whitehead   = to_pct(out$power_WH),
        check.names = FALSE
      )
    })
    
    do.call(rbind, res_list)
  })
  
  # -----------------------------
  # Minimum clusters text
  # -----------------------------
  output$min_clusters_text <- renderText({
    df <- power_df()
    
    target_pct <- round(input$target_power, 2)
    idx <- which(df$GEE_Ordinal >= target_pct)
    
    if (length(idx) == 0) {
      return(sprintf(
        "GEE-Ordinal: target %.2f%% not reached in the selected N range.",
        target_pct
      ))
    }
    
    N_star <- df$N[min(idx)]
    sprintf(
      "GEE-Ordinal: minimum number of clusters to reach target %.2f%% is N = %d.",
      target_pct, N_star
    )
  })
  
  # -----------------------------
  # Plot
  # -----------------------------
  output$power_curve <- renderPlotly({
    df <- power_df()
    shiny::validate(need(!is.null(df), "Unable to generate power curve."))
    
    cols <- list(
      Ordinal = "#78C2AD",
      Bin1    = "#5FA4D0",
      Bin2    = "#E59A9A",
      Indep   = "#9A8FB4",
      WH      = "#E5B64B"
    )
    
    target_pct <- round(input$target_power, 2)
    idx <- which(df$GEE_Ordinal >= target_pct)
    
    p <- plot_ly(df, x = ~N)
    
    p <- p %>% add_lines(
      y = ~GEE_Ordinal,
      name = "GEE-Ordinal",
      line = list(color = cols$Ordinal, width = 3),
      hovertemplate = "N=%{x}<br>Power=%{y:.2f}%<extra></extra>"
    )
    
    if (!all(is.na(df$GEE_Binary1))) {
      p <- p %>% add_lines(
        y = ~GEE_Binary1,
        name = "GEE-Binary1 (0 vs 1,2)",
        line = list(color = cols$Bin1, width = 3, dash = "dash"),
        hovertemplate = "N=%{x}<br>Power=%{y:.2f}%<extra></extra>"
      )
    }
    
    if (!all(is.na(df$GEE_Binary2))) {
      p <- p %>% add_lines(
        y = ~GEE_Binary2,
        name = "GEE-Binary2 (0,1 vs 2)",
        line = list(color = cols$Bin2, width = 3, dash = "longdash"),
        hovertemplate = "N=%{x}<br>Power=%{y:.2f}%<extra></extra>"
      )
    }
    
    if (!all(is.na(df$Whitehead))) {
      p <- p %>% add_lines(
        y = ~Whitehead,
        name = "Whitehead",
        line = list(color = cols$WH, width = 3, dash = "dashdot"),
        hovertemplate = "N=%{x}<br>Power=%{y:.2f}%<extra></extra>"
      )
    }
    
    if (!all(is.na(df$GEE_Indep))) {
      p <- p %>% add_lines(
        y = ~GEE_Indep,
        name = "GEE-Indep",
        line = list(color = cols$Indep, width = 3, dash = "longdash"),
        hovertemplate = "N=%{x}<br>Power=%{y:.2f}%<extra></extra>"
      )
    }
    
    p <- p %>% add_lines(
      x = df$N,
      y = rep(target_pct, nrow(df)),
      name = sprintf("Target = %.2f%%", target_pct),
      line = list(color = "#717171", dash = "dash", width = 2),
      hoverinfo = "skip"
    )
    
    if (length(idx) > 0) {
      i0 <- min(idx)
      p <- p %>% add_markers(
        x = df$N[i0],
        y = df$GEE_Ordinal[i0],
        name = "Min N (GEE-Ordinal)",
        marker = list(color = cols$Ordinal, size = 10),
        hovertemplate = "Min N=%{x}<br>Power=%{y:.2f}%<extra></extra>"
      )
    }
    
    p %>% layout(
      hovermode = "x unified",
      yaxis = list(title = "Power (%)", range = c(0, 100)),
      xaxis = list(title = "Number of Clusters (Total)"),
      legend = list(orientation = "h", x = 0, y = -0.25)
    )
  })
  
  output$clusters_assumed_plot <- renderPlotly({
    df <- clusters_assumed_df()
    #print(str(df))
    #print(unique(df$method))
    shape_vals <- c(16, 17, 15, 18, 3, 4, 8)
    shape_map <- setNames(shape_vals[seq_along(unique(df$rho_label))],
                          sort(unique(as.character(df$rho_label))))
    
    color_vals <- c(
      "#0072B2", "#CC79A7", "#E69F00",
      "#009E73", "#D55E00", "#56B4E9", "#000000"
    )
    color_map <- setNames(color_vals[seq_along(unique(df$rho_label))],
                          sort(unique(as.character(df$rho_label))))
    
    y_top <- (ceiling(max(df$N_continuous, na.rm = TRUE) / 5) + 1) * 5
    g <- ggplot(
      df,
      aes(
        x = method,
        y = N_continuous,
