  # -----------------------------
  # Current rho combination validity
  # -----------------------------
  current_rho_valid <- reactive({
    x <- resolved_inputs()
    
    rho_mat <- matrix(c(input$rho11, input$rho12,
                        input$rho12, input$rho22), nrow = 2, byrow = TRUE)
    
    M <- tryCatch(
      gee_info_mat_3cat(
        pi_T1 = x$p_T_vec[1],
        pi_T2 = x$p_T_vec[2],
        pi_C1 = x$p_C_vec[1],
        pi_C2 = x$p_C_vec[2],
        rho_mat = rho_mat,
        cluster_size = input$J
      ),
      error = function(e) NULL
    )
    
    !is.null(M) && is_valid_gee_info_mat(M)
  })
  
  output$rho_validity_text <- renderUI({
    if (current_rho_valid()) {
      HTML("Current &rho; combination is valid and yields positive V<sub>&theta;</sub>.")
    } else {
      HTML("Current &rho; combination is not valid: it does not yield positive V<sub>&theta;</sub>.")
    }
  })
  
  output$clusters_assumed_title <- renderUI({
    h4(sprintf(
      "Required total number of clusters to reach a target power of %.0f%% (Outcome definition × Treatment effect × \u03c1)",
      input$target_power
    ))
  })
  
  rho_entry_grid_reactive <- reactive({
    g <- parse_rho_grid(
      mode = input$rho_grid_mode,
      rho_min = input$rho_grid_min,
      rho_max = input$rho_grid_max,
      rho_step = input$rho_grid_step,
      rho_custom = input$rho_grid_custom
    )
    
    shiny::validate(
      need(length(g) <= 8, "Please provide at most 8 rho grid values.")
