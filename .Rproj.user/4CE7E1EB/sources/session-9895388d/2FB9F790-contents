    }
  })
  
  output$rho12_range_text <- renderText({
    rr <- rho12_range()
    if (is.na(rr$min)) {
      "No valid range found on the search grid."
    } else {
      sprintf("Given current \u03c1\u2081\u2081 and \u03c1\u2082\u2082, valid range: [%.3f, %.3f]", rr$min, rr$max)
    }
