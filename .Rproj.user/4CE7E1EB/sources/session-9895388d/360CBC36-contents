      jointpmf_ct = gen_jointpmf(SetupInfo_ct)$jointpmf
      jointpmf = (jointpmf_trt+jointpmf_ct)/2
      #sum(jointpmf )
      VC_ordinal_mat = rbind(Ordinal_PMF(jointpmf,method='sum'),
                             # component 6 least severe, 1 most severe
                             Ordinal_PMF(jointpmf,method='order',
                                         severity_score_increasing=6:1),
                             # component 1 least severe, 6 most severe
                             Ordinal_PMF(jointpmf,method='order',
                                         severity_score_increasing=1:6))
      
      VCOpower = whitehead_power(VC_ordinal_mat,
                                 est_coef_Xs= assume_effect_size,
                                 n=n1)
      VCO_out[VCO_out$chunk==ci,paste0("power_wh_VCO",VCsetting)] = VCOpower
    }
  }
  VCO_out
  
  #### combine all the powers
  final_VCO_out = left_join(power_nonVCO,
                            VCO_out %>% select(Comp_BinY,n,power_wh_VCO1:power_wh_VCO9),
